      "inspected": "2026-06-16",
      "license": "EUPL-1.2"
    }
  },
  "nix": {
    "nixpkgs": {
      "ref": "nixos-25.11",
      "rev": "d6df3513510aa548c83868fd22bfddd0a8c0a0d4",
