#!/usr/bin/env bash
#
# dawo-appliance-bootstrap — runs on the booted live ISO.
#
# Default path is NON-DESTRUCTIVE (`plan`, `verify`):
#   1. (optional) check internet connectivity
#   2. download a pinned release manifest of this repository
#   3. verify the manifest against a trusted, version-controlled SHA-256
#   4. show what WOULD be installed (the plan)
#   5. write NOTHING to disk
#
# The only disk-writing action is the `install` subcommand (Slice 2b). It
# requires BOTH --target-disk and --confirm-destroy, runs safety checks, and
# offers --dry-run. `plan`/`verify` refuse those flags.
#
# Experimental and unofficial. Not an official DAWO / Mijn Bureau / BZK tool.

set -euo pipefail

PROGRAM_NAME="dawo-appliance-bootstrap"
PROGRAM_VERSION="0.1.0-dev"

# Resolve the directory this script lives in, to find the trusted checksum that
# ships alongside it (inside the repo / read-only ISO).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Placeholder. There is no published release yet (see OQ-8). Override with
# --manifest-url. For local testing use a file:// URL.
DEFAULT_MANIFEST_URL="https://example.invalid/dawo-appliance/RELEASE/appliance-manifest.json"

# Trusted expected checksum: shipped in the repo / ISO, NOT downloaded with the
# manifest. This is the root of trust for v0.1. We search known locations: the
# repo checkout (development) and /etc (on the live ISO).
pick_expected_sha_file() {
  local candidates=(
    "${REPO_ROOT}/manifest/appliance-manifest.json.sha256"
    "/etc/dawo-appliance/manifest/appliance-manifest.json.sha256"
  )
  local c
  for c in "${candidates[@]}"; do
    [[ -f "${c}" ]] && { printf '%s' "${c}"; return 0; }
  done
  printf '%s' "${candidates[0]}"
}
DEFAULT_EXPECTED_SHA_FILE="$(pick_expected_sha_file)"

# Host used only for the connectivity probe (the repo host).
CONNECTIVITY_PROBE_URL="https://code.overheid.nl"

# The NixOS configuration to install (Slice 2). On a real install medium the
# flake is shipped read-only; override with --flake. The attribute is the
# appliance host defined in this repository's flake.
DEFAULT_FLAKE_REF="/etc/dawo-appliance/config"
# The nixosConfiguration to install. DAWO_APPLIANCE_INSTALL_ATTR exists only so
# the end-to-end test can install the test-instrumented variant (appliance-e2e);
# operators never need it.
INSTALL_ATTR="${DAWO_APPLIANCE_INSTALL_ATTR:-appliance}"

# --- options ---------------------------------------------------------------
MANIFEST_URL="${DEFAULT_MANIFEST_URL}"
GENERATE_PASSWORD=0
ALLOW_SMALL_STORE=0
EXPECTED_SHA=""
EXPECTED_SHA_FILE="${DEFAULT_EXPECTED_SHA_FILE}"
OFFLINE=0
TARGET_DISK=""
CONFIRM_DESTROY=0
WORK_DIR=""
FLAKE_REF="${DEFAULT_FLAKE_REF}"
DRY_RUN=0

log()  { printf '[%s] %s\n' "${PROGRAM_NAME}" "$*" >&2; }
err()  { printf '[%s] ERROR: %s\n' "${PROGRAM_NAME}" "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
  cat <<EOF
${PROGRAM_NAME} ${PROGRAM_VERSION} (experimental, unofficial)

Usage:
  ${PROGRAM_NAME} <command> [options]

Commands:
  plan       Download + verify the manifest and print the install plan.
             Writes nothing to disk. (default)
  verify     Download + verify the manifest checksum only.
  install    Partition + format + install the appliance host onto an explicit
             target disk. DESTRUCTIVE: requires --target-disk AND
             --confirm-destroy. Use --dry-run to preview without writing.
  version    Print version.
  help       Show this help.

Options:
  --manifest-url URL          Manifest location (http(s):// or file://).
                              Default: ${DEFAULT_MANIFEST_URL}
  --expected-sha256 HEX       Expected SHA-256 of the manifest (overrides file).
  --expected-sha256-file F    File containing the expected SHA-256
                              (default: <repo>/manifest/appliance-manifest.json.sha256).
  --offline                   Skip the internet connectivity check.
  --work-dir DIR              Scratch dir for the download (default: mktemp).
  --target-disk DEV           Explicit install target (a block device, e.g.
                              /dev/sda). Required by 'install'. NEVER defaulted.
  --confirm-destroy           Confirm that 'install' may ERASE the target disk.
  --flake REF                 Flake to install (default: ${DEFAULT_FLAKE_REF}).
  --generate-password         install only: give user 'dawo' a random first-login
                              password instead of upstream's documented default.
                              Shown at install and in the welcome dialog (demo
                              appliance, not for production). Default: off.
  --allow-small-store         install only: skip the free-space check on the live
                              Nix store (the appliance closure needs ~12 GiB).
                              The '#${INSTALL_ATTR}' attribute is used.
  --dry-run                   For 'install': print the plan and the exact command
                              that WOULD run, and write nothing.
  -h, --help                  Show this help.

Safety: 'plan'/'verify' are non-destructive and refuse --target-disk /
--confirm-destroy. 'install' writes to disk ONLY when given BOTH an explicit
--target-disk AND --confirm-destroy; otherwise it refuses. --dry-run never
writes.
EOF
}

# --- helpers ---------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

check_connectivity() {
  if [[ "${OFFLINE}" -eq 1 ]]; then
    log "connectivity check skipped (--offline)"
    return 0
  fi
  log "checking internet connectivity (${CONNECTIVITY_PROBE_URL}) ..."
  if have curl && curl -fsS --max-time 10 -I "${CONNECTIVITY_PROBE_URL}" >/dev/null 2>&1; then
    log "connectivity OK"
    return 0
  fi
  die "no internet connectivity (use --offline for local testing)"
}

download_manifest() {
  local url="$1" dest="$2"
  log "downloading manifest: ${url}"
  if [[ "${url}" == file://* ]]; then
    local path="${url#file://}"
    [[ -f "${path}" ]] || die "manifest file not found: ${path}"
    cp -- "${path}" "${dest}"
  elif have curl; then
    curl -fsS --max-time 60 -o "${dest}" -- "${url}" \
      || die "failed to download manifest from ${url}"
  else
    die "curl is required to download ${url}"
  fi
  [[ -s "${dest}" ]] || die "downloaded manifest is empty"
}

resolve_expected_sha() {
  if [[ -n "${EXPECTED_SHA}" ]]; then
    log "using expected SHA-256 from --expected-sha256"
    return 0
  fi
  [[ -f "${EXPECTED_SHA_FILE}" ]] \
    || die "expected-sha256 file not found: ${EXPECTED_SHA_FILE}"
  # File format: "<sha256>  <filename>" (sha256sum output). Take the first field.
  EXPECTED_SHA="$(awk 'NR==1{print $1}' "${EXPECTED_SHA_FILE}")"
  [[ "${EXPECTED_SHA}" =~ ^[0-9a-f]{64}$ ]] \
    || die "invalid expected SHA-256 in ${EXPECTED_SHA_FILE}"
  log "using trusted expected SHA-256 from ${EXPECTED_SHA_FILE}"
}

verify_manifest() {
  local file="$1" actual
  actual="$(sha256sum "${file}" | awk '{print $1}')"
  if [[ "${actual}" != "${EXPECTED_SHA}" ]]; then
    err "manifest checksum MISMATCH"
    err "  expected: ${EXPECTED_SHA}"
    err "  actual:   ${actual}"
    die "refusing to use an unverified manifest"
  fi
  log "manifest checksum verified: ${actual}"
}

render_plan() {
  local file="$1"
  echo
  echo "=========================================================="
  echo " dawo-appliance — INSTALL PLAN (dry-run, nothing written)"
  echo "=========================================================="
  if have jq; then
    _render_plan_jq "${file}"
  elif have python3; then
    _render_plan_python "${file}"
  else
    echo "(no jq or python3 available to pretty-print; raw manifest follows)"
    cat "${file}"
  fi
  echo
  echo "NO DISK WRITES PERFORMED. This is a plan only (v0.1)."
  echo "=========================================================="
}

_render_plan_jq() {
  local file="$1"
  jq -r '
    "appliance:        \(.appliance.name) \(.appliance.version) (official: \(.appliance.official))",
    "architecture:     \(.architecture)",
    "DAWO-Core rev:    \(.upstream.dawo_core.rev) (tag \(.upstream.dawo_core.tag))",
    "Mijn Bureau rev:  \(.upstream.mijn_bureau_infra.rev)",
    "nixpkgs rev:      \(.nix.nixpkgs.rev) (\(.nix.nixpkgs.ref))",
    "host requirement: >= \(.host.min_vcpu) vCPU, >= \(.host.min_ram_gib) GiB RAM, desktop: \(.host.desktop)",
    "VM:               \(.vm.os) — >= \(.vm.min_vcpu) vCPU, >= \(.vm.min_ram_gib) GiB RAM",
    "Kubernetes:       \(.kubernetes.distribution) (\(.kubernetes.mode))",
    "dashboard URL:    \(.mijn_bureau.dashboard.url_template)",
    "",
    "Steps that WOULD run:",
    (.install_plan | to_entries[] | "  \(.key + 1). \(.value)"),
    "",
    "Pending pins / decisions (must be resolved before those steps):",
    (.pending_pins[] | "  - \(.)")
  ' "${file}"
}

_render_plan_python() {
  local file="$1"
  python3 - "$file" <<'PY'
import json, sys
m = json.load(open(sys.argv[1]))
a = m["appliance"]
print(f"appliance:        {a['name']} {a['version']} (official: {a['official']})")
print(f"architecture:     {m['architecture']}")
print(f"DAWO-Core rev:    {m['upstream']['dawo_core']['rev']} (tag {m['upstream']['dawo_core']['tag']})")
print(f"Mijn Bureau rev:  {m['upstream']['mijn_bureau_infra']['rev']}")
nx = m["nix"]["nixpkgs"]
print(f"nixpkgs rev:      {nx['rev']} ({nx['ref']})")
h = m["host"]
print(f"host requirement: >= {h['min_vcpu']} vCPU, >= {h['min_ram_gib']} GiB RAM, desktop: {h['desktop']}")
v = m["vm"]
print(f"VM:               {v['os']} — >= {v['min_vcpu']} vCPU, >= {v['min_ram_gib']} GiB RAM")
k = m["kubernetes"]
print(f"Kubernetes:       {k['distribution']} ({k['mode']})")
print(f"dashboard URL:    {m['mijn_bureau']['dashboard']['url_template']}")
print()
print("Steps that WOULD run:")
for i, step in enumerate(m["install_plan"], 1):
    print(f"  {i}. {step}")
print()
print("Pending pins / decisions (must be resolved before those steps):")
for p in m.get("pending_pins", []):
    print(f"  - {p}")
PY
}

guard_destructive() {
  if [[ -n "${TARGET_DISK}" || "${CONFIRM_DESTROY}" -eq 1 ]]; then
    err "this command is non-destructive; --target-disk / --confirm-destroy are"
    err "  not valid here. To install, use the 'install' command. Refusing."
    exit 3
  fi
}

# Validate that TARGET_DISK is a safe, explicit install target. Every check is
# fatal for a real install. The caller is responsible for honouring --dry-run.
validate_target_disk() {
  local dev="$1"

  [[ -n "${dev}" ]] || die "no --target-disk given (never defaulted; refusing)"
  [[ -b "${dev}" ]] || die "target disk is not a block device: ${dev}"

  # Refuse if the device, or any of its partitions, is currently mounted.
  # (`grep -c` exits 1 on zero matches; with pipefail that must not abort us.)
  if have lsblk; then
    local mounted
    mounted="$(lsblk -nro MOUNTPOINT "${dev}" 2>/dev/null | grep -c . || true)"
    [[ "${mounted}" -eq 0 ]] \
      || die "refusing: ${dev} (or one of its partitions) is mounted"
  fi

  # Refuse if it is the disk currently backing the live/root filesystem.
  if have findmnt && have lsblk; then
    local root_src root_disk target_disk
    root_src="$(findmnt -nro SOURCE / 2>/dev/null || true)"
    if [[ -n "${root_src}" && -b "${root_src}" ]]; then
      root_disk="$(lsblk -nro PKNAME "${root_src}" 2>/dev/null | head -1)"
      target_disk="$(lsblk -nro KNAME "${dev}" 2>/dev/null | head -1)"
      if [[ -n "${root_disk}" && "${root_disk}" == "${target_disk}" ]]; then
        die "refusing: ${dev} backs the running system (/)"
      fi
    fi
  fi
}

# Checks on the live environment that only matter once we are really going to
# install. Run after the confirmation gate so the operator always sees the
# confirmation refusal first.
MIN_STORE_FREE_GIB=12
validate_install_environment() {
  # The appliance layout is GPT + ESP and upstream's boot-loader is systemd-boot:
  # a legacy-BIOS boot of the ISO would wipe the disk and then fail bootctl.
  [[ -d /sys/firmware/efi ]] \
    || die "the installer is not running in UEFI mode; reboot the ISO in UEFI mode (GPT + ESP layout, systemd-boot)"

  # disko-install first realises the whole appliance closure (Plasma, the pilot
  # apps) in the LIVE system's Nix store, which on the ISO is RAM-backed. Too
  # little room means a failure after the disk has been erased.
  local avail
  avail="$(df --output=avail -B1 /nix/store 2>/dev/null | tail -1 | tr -d ' ' || true)"
  if [[ "${ALLOW_SMALL_STORE}" -ne 1 && -n "${avail}" && "${avail}" -lt $((MIN_STORE_FREE_GIB * 1024 * 1024 * 1024)) ]]; then
    die "only $((avail / 1024 / 1024 / 1024)) GiB free in the live Nix store (/nix/store); the appliance closure needs about ${MIN_STORE_FREE_GIB} GiB. Use a machine with more RAM, or pass --allow-small-store to try anyway."
  fi
}

# Where the installed system expects the first-login password hash; applied
# once at first boot by dawo-appliance-set-password.service
# (hosts/appliance/appliance-services.nix) and then removed. The plain text
# (dawo.password.txt, next to it) stays for the welcome dialog: demo appliance,
# NOT for production.
PASSWORD_HASH_PATH="/var/lib/dawo-appliance/dawo.password-hash"

# A random first-login password: 16 unambiguous lower-case letters/digits in
# groups of four. Read from a fixed amount of urandom so no pipe is cut short
# (pipefail would turn a SIGPIPE'd tr into a failure).
generate_password() {
  local raw
  raw="$(LC_ALL=C tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' < <(head -c 512 /dev/urandom) | cut -c1-16)"
  [[ ${#raw} -eq 16 ]] || die "could not generate a password"
  printf '%s-%s-%s-%s' "${raw:0:4}" "${raw:4:4}" "${raw:8:4}" "${raw:12:4}"
}

# stage_password_files STAGE PASSWORD — build the tree that disko-install copies
# into the fresh root with `--extra-files STAGE/var /var` (cp -ar). Right after
# formatting the target has no /var yet, so cp creates it from the stage; the
# stage's OWN root directory is never mapped onto / — doing that (cp -ar
# STAGE/. ROOT/) copies the 0700 mode of a mktemp directory onto / and leaves
# the installed system unbootable. Directory modes are therefore set to 0755
# explicitly. Also reachable as the internal subcommand `stage-password-files`
# so the test suite can verify exactly this layout.
stage_password_files() {
  local stage="$1" password="$2" dir
  dir="${stage}${PASSWORD_HASH_PATH%/*}"
  mkdir -p "${dir}"
  chmod 755 "${stage}/var" "${stage}/var/lib" "${dir}"
  (
    umask 077
    printf '%s\n' "${password}" | mkpasswd -m yescrypt --stdin > "${stage}${PASSWORD_HASH_PATH}"
  )
  # Demo appliance, NOT for production: the plain password is also shipped,
  # world-readable, so the welcome dialog can show it after auto-login.
  printf '%s\n' "${password}" > "${dir}/dawo.password.txt"
  chmod 644 "${dir}/dawo.password.txt"
}

cmd_install() {
  # Hard rule: an explicit target disk is always required.
  validate_target_disk_for_mode

  # NixOS puts /etc entries behind symlinks into the store; Nix refuses a
  # symlink as a path flake, so resolve the default (or any directory) first,
  # and name it explicitly as a `path:` flake: a bare directory that contains a
  # `.git` entry is otherwise treated as a git repository (found by the
  # end-to-end test, issue #14).
  if [[ -d "${FLAKE_REF}" || -L "${FLAKE_REF}" ]]; then
    FLAKE_REF="path:$(readlink -f "${FLAKE_REF}")"
  fi
  local flake_target="${FLAKE_REF}#${INSTALL_ATTR}"
  # disko-install performs partition + format + mount + nixos-install in one
  # step, overriding the disk device explicitly (so nothing is hard-coded).
  # --write-efi-boot-entries: register systemd-boot in the firmware instead of
  # relying on the removable fallback path alone.
  local -a cmd=(disko-install --flake "${flake_target}" --disk main "${TARGET_DISK}" --write-efi-boot-entries)

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    echo
    echo "=========================================================="
    echo " dawo-appliance — INSTALL PLAN (dry-run, nothing written)"
    echo "=========================================================="
    echo "target disk:  ${TARGET_DISK}"
    echo "flake:        ${flake_target}"
    if [[ "${GENERATE_PASSWORD}" -eq 1 ]]; then
      echo "would run:    ${cmd[*]} --extra-files <stage>/var /var"
      echo "would set:    a generated first-login password for user 'dawo'"
      echo "              (hash to ${PASSWORD_HASH_PATH}; plain text next to it"
      echo "              for the welcome dialog — demo appliance, not for production)"
    else
      echo "would run:    ${cmd[*]}"
      echo "login:        user 'dawo' with upstream's documented default password"
      echo "              (add --generate-password for a random one)"
    fi
    [[ -d /sys/firmware/efi ]] || echo "note:         not booted in UEFI mode; a real install would refuse"
    echo
    echo "NO DISK WRITES PERFORMED. Re-run with --confirm-destroy (and without"
    echo "--dry-run) to ERASE ${TARGET_DISK} and install."
    echo "=========================================================="
    return 0
  fi

  # Real install: require explicit confirmation and a working installer.
  if [[ "${CONFIRM_DESTROY}" -ne 1 ]]; then
    err "install will ERASE ALL DATA on ${TARGET_DISK}."
    die "refusing without --confirm-destroy (preview with --dry-run)"
  fi
  have disko-install || die "disko-install not found on PATH (the install medium must ship it)"
  validate_install_environment

  # First-login password for the `dawo` account (ADR 0003). Default: upstream's
  # documented bootstrap default stays (the appliance auto-logs in and the
  # welcome dialog shows it). With --generate-password a random password is
  # generated here; its yescrypt hash AND its plain text go into the fresh
  # root (see stage_password_files), where dawo-appliance-set-password.service
  # applies the hash at first boot and the welcome dialog shows the text.
  local stage="" password=""
  if [[ "${GENERATE_PASSWORD}" -eq 1 ]]; then
    have mkpasswd || die "mkpasswd not found on PATH (the install medium must ship it)"
    stage="$(mktemp -d)"
    # shellcheck disable=SC2064  # expand now: the stage path is fixed
    trap "rm -rf '${stage}'" EXIT
    password="$(generate_password)"
    stage_password_files "${stage}" "${password}"
    cmd+=(--extra-files "${stage}/var" /var)
  fi

  log "ERASING ${TARGET_DISK} and installing ${flake_target} ..."
  "${cmd[@]}"

  echo
  echo "=========================================================="
  echo " dawo-appliance — INSTALLED on ${TARGET_DISK}"
  echo "=========================================================="
  if [[ -n "${password}" ]]; then
    echo " First login:  user 'dawo'   password: ${password}"
    echo " It is applied at first boot; the welcome dialog on the desktop shows"
    echo " it again (demo appliance, not for production). Change it with passwd."
  else
    echo " The appliance logs in automatically as user 'dawo'. The screen lock"
    echo " and admin tasks use upstream's documented default password; the"
    echo " welcome dialog on the desktop shows it."
  fi
  echo " Reboot to start the appliance."
  echo "=========================================================="
  log "install complete. Reboot to start the appliance host."
}

# Gate shared by dry-run and real install: a target disk is always required;
# its block-device/mount/live-medium checks are fatal only for a real write.
validate_target_disk_for_mode() {
  [[ -n "${TARGET_DISK}" ]] \
    || die "install requires --target-disk DEV (never defaulted; refusing)"
  if [[ "${DRY_RUN}" -ne 1 ]]; then
    validate_target_disk "${TARGET_DISK}"
  fi
}

# --- argument parsing ------------------------------------------------------
COMMAND="plan"
if [[ $# -gt 0 && "$1" != -* ]]; then
  COMMAND="$1"; shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --manifest-url)          MANIFEST_URL="${2:?}"; shift 2 ;;
    --expected-sha256)       EXPECTED_SHA="${2:?}"; shift 2 ;;
    --expected-sha256-file)  EXPECTED_SHA_FILE="${2:?}"; shift 2 ;;
    --offline)               OFFLINE=1; shift ;;
    --work-dir)              WORK_DIR="${2:?}"; shift 2 ;;
    --target-disk)           TARGET_DISK="${2:?}"; shift 2 ;;
    --confirm-destroy)       CONFIRM_DESTROY=1; shift ;;
    --flake)                 FLAKE_REF="${2:?}"; shift 2 ;;
    --generate-password)     GENERATE_PASSWORD=1; shift ;;
    --allow-small-store)     ALLOW_SMALL_STORE=1; shift ;;
    --dry-run)               DRY_RUN=1; shift ;;
    -h|--help)               usage; exit 0 ;;
    *) die "unknown option: $1 (try: ${PROGRAM_NAME} help)" ;;
  esac
done

# --- commands --------------------------------------------------------------
cmd_verify_or_plan() {
  local do_plan="$1"
  guard_destructive
  check_connectivity
  resolve_expected_sha

  local cleanup=0 workdir manifest
  if [[ -n "${WORK_DIR}" ]]; then
    mkdir -p "${WORK_DIR}"; workdir="${WORK_DIR}"
  else
    workdir="$(mktemp -d "${TMPDIR:-/tmp}/dawo-bootstrap.XXXXXX")"; cleanup=1
  fi
  manifest="${workdir}/appliance-manifest.json"

  download_manifest "${MANIFEST_URL}" "${manifest}"
  verify_manifest "${manifest}"

  if [[ "${do_plan}" -eq 1 ]]; then
    render_plan "${manifest}"
  else
    log "verify OK"
  fi

  [[ "${cleanup}" -eq 1 ]] && rm -rf "${workdir}"
  return 0
}

case "${COMMAND}" in
  plan)    cmd_verify_or_plan 1 ;;
  verify)  cmd_verify_or_plan 0 ;;
  install) cmd_install ;;
    # Internal, for the test suite: build the password stage tree in DIR.
    stage-password-files)
      [[ $# -ge 0 ]] || true
      have mkpasswd || die "mkpasswd not found on PATH"
      [[ -n "${STAGE_DIR:-}" && -n "${STAGE_PASSWORD:-}" ]] \
        || die "stage-password-files needs STAGE_DIR and STAGE_PASSWORD in the environment"
      stage_password_files "${STAGE_DIR}" "${STAGE_PASSWORD}" ;;
  version) echo "${PROGRAM_NAME} ${PROGRAM_VERSION}" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: ${COMMAND} (try: ${PROGRAM_NAME} help)" ;;
esac
