# cloud-init network-config (v2) for the appliance guest: one virtio NIC,
# matched by the fixed MAC, DHCP from the libvirt network (fixed lease
# @GUEST_ADDRESS@, DNS server and search domain from the same dnsmasq).
version: 2
ethernets:
  primary:
    match:
      macaddress: "@GUEST_MAC@"
    dhcp4: true
    dhcp6: false
    dhcp4-overrides:
      use-dns: true
      use-domains: true
